generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Používateľský účet + osobný profil a denné ciele (multi-user).
model User {
  id           String   @id @default(cuid())
  username     String   @unique // ukladaný malými písmenami
  passwordHash String
  role         String   @default("user") // admin | user
  createdAt    DateTime @default(now())

  // Profil a denné ciele
  name         String  @default("Ja")
  sex          String?
  age          Int?
  heightCm     Float?
  weightKg     Float?
  activity     String?
  goalType     String?
  goalCalories Int     @default(2000)
  goalProtein  Int     @default(120)
  goalCarbs    Int     @default(220)
  goalFat      Int     @default(65)
  goalWaterMl  Int     @default(2500)

  entries    Entry[]
  foods      Food[]
  waterLogs  WaterLog[]
}

// Záznam vypitej tekutiny (pitný režim) – nezávislý od jedál
model WaterLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  ml        Int
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// (Zastaraný – pôvodný jednopoužívateľský profil; ponechaný kvôli kompatibilite DB)
model Profile {
  id        Int      @id @default(1)
  name      String   @default("Ja")

  // Osobné údaje pre výpočet odporúčaného príjmu (TDEE)
  sex       String?  // "male" | "female"
  age       Int?
  heightCm  Float?
  weightKg  Float?
  activity  String?  // "sedentary" | "light" | "moderate" | "active" | "very_active"
  goalType  String?  // "lose" | "maintain" | "gain"

  // Denné ciele
  goalCalories Int   @default(2000)
  goalProtein  Int   @default(120)
  goalCarbs    Int   @default(220)
  goalFat      Int   @default(65)

  updatedAt DateTime @updatedAt @default(now())
}

// Jeden záznam zjedeného jedla v denníku
model Entry {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String   // YYYY-MM-DD (lokálny dátum)
  mealType      String   @default("other") // breakfast | lunch | dinner | snack | other
  name          String
  quantityGrams Float?
  calories      Float
  protein       Float    @default(0)
  carbs         Float    @default(0)
  fat           Float    @default(0)
  fiber         Float?
  category      String?
  subcategory   String?
  healthIndex   Float?   // 0..10 – odhad zdravosti jedla
  note          String?
  source        String   @default("manual") // ai | manual | db
  createdAt     DateTime @default(now())

  @@index([userId, date])
  @@index([category])
}

// Referenčná databáza potravín (hodnoty na 100 g, ak nie je uvedené inak)
model Food {
  id          String  @id @default(cuid())
  userId      String? // null = zdieľaná všeobecná potravina; inak súkromná pre používateľa
  user        User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  brand       String?
  category    String?
  subcategory String?
  barcode     String?
  baseGrams   Float   @default(100)
  calories    Float
  protein     Float   @default(0)
  carbs       Float   @default(0)
  fat         Float   @default(0)
  fiber       Float?
  healthIndex Float?  // 0..10
  source      String   @default("seed") // seed | openfoodfacts | manual | auto
  createdAt   DateTime @default(now())

  @@index([name])
  @@index([userId])
  @@index([barcode])
}
