# ──────────────────────────────────────────────────────────────
#  NutriAI – konfigurácia prostredia
#  Skopíruj tento súbor ako `.env` a doplň hodnoty.
# ──────────────────────────────────────────────────────────────

# Pripojenie na Postgres databázu (Neon / Supabase / Vercel Postgres).
# Príklad (Neon): postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Google Gemini API kľúč – získaš na https://aistudio.google.com/apikey
GEMINI_API_KEY="..."

# Model Gemini (voliteľné, default gemini-3.1-flash-lite)
# Pozn.: gemini-2.0-flash bol odstavený 1.6.2026; gemini-2.5-flash beží do 16.10.2026.
GEMINI_MODEL="gemini-3.1-flash-lite"

# POVINNÉ: tajný kľúč na podpis prihlasovacej cookie (min. 16 znakov).
# Bez neho sa NIKTO neprihlási. Vygeneruj napr.: openssl rand -base64 32
SESSION_SECRET="zmen-ma-na-nahodny-dlhy-retazec-min-16"

# Registračný kód pre vytváranie účtov (dáš ho kamarátovi).
# Ak nie je nastavený, použije sa staršia premenná APP_PASSWORD (ak ju máš).
REGISTRATION_CODE="zvol-si-tajny-kod"

# ── PUSH NOTIFIKÁCIE (povinné, ak chceš notifikácie) ──────────
# VAPID kľúče pre Web Push. Bez nich sa notifikácie NEDAJÚ zapnúť.
# Vygeneruj pár príkazom:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
# Kontaktný subjekt (e-mail) – pre VAPID hlavičku.
VAPID_SUBJECT="mailto:tvoj@email.sk"

# ── CRON (automatické pripomienky voda/kouč) ─────────────────
# Tajný kľúč pre cron endpointy. Vo Verceli ho nastav rovnako;
# Vercel ho automaticky posiela v hlavičke Authorization pri cron behu.
CRON_SECRET="nahodny-tajny-retazec"

