# ──────────────────────────────────────────────────────────────
#  NutriAI – konfigurácia prostredia
#  Skopíruj tento súbor ako `.env` a doplň hodnoty.
# ──────────────────────────────────────────────────────────────

# Pripojenie na Postgres databázu (Neon / Supabase / Vercel Postgres).
# Príklad (Neon): postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Google Gemini API kľúč – získaš na https://aistudio.google.com/apikey
GEMINI_API_KEY="..."

# Model Gemini (voliteľné, default gemini-3.5-flash)
# Pozn.: gemini-2.0-flash bol odstavený 1.6.2026; gemini-2.5-flash beží do 16.10.2026.
GEMINI_MODEL="gemini-3.5-flash"

# Heslo do aplikácie (prihlásenie). Zvoľ si vlastné silné heslo.
APP_PASSWORD="zmen-ma-na-silne-heslo"

# Tajný kľúč na podpis prihlasovacej cookie (náhodný dlhý reťazec).
# Vygeneruj napr.: openssl rand -base64 32
SESSION_SECRET="zmen-ma-na-nahodny-dlhy-retazec"
