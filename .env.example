# ──────────────────────────────────────────────────────────────
#  Rypák (NutriAI) – konfigurácia prostredia
#  Skopíruj tento súbor ako `.env` a doplň hodnoty. `.env` sa necommituje.
# ──────────────────────────────────────────────────────────────

# Postgres (Supabase). Pre lokálny vývoj a zálohy použi Supabase „Session pooler"
# (port 5432) – priame pripojenie db.<ref>.supabase.co je len cez IPv6.
DATABASE_URL="postgresql://postgres.ref:HESLO@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"
# Spojenie pre migrácie (prisma migrate deploy). Ak chýba, použije sa DATABASE_URL.
# DIRECT_URL=""

# ── AI: OpenAI (POVINNÉ pre všetky AI funkcie) ───────────────
# Rozpoznávanie jedla z textu a z fotky, tabuľka z obalu, zdravosť, kouč.
# Bez kľúča AI funkcie nefungujú (kouč použije záložné vety). Nikdy necommituj.
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4.1"
# OPENAI_FALLBACK_MODEL="gpt-4o-mini"
# OPENAI_TIMEOUT_MS="45000"

# POVINNÉ: tajný kľúč na podpis prihlasovacej cookie (min. 16 znakov, ideálne 32+).
# Vygeneruj: openssl rand -base64 32   – NIKDY nenechávaj ukážkovú hodnotu.
SESSION_SECRET=""

# Registračný kód pre vytváranie účtov (dáš ho kamarátovi).
REGISTRATION_CODE=""

# ── PUSH NOTIFIKÁCIE (povinné, ak chceš notifikácie) ──────────
# Vygeneruj pár príkazom:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tvoj@email.sk"

# ── CRON (pripomienky voda/kouč) – POVINNÉ pre notifikácie ───
# Rovnaká hodnota vo Verceli aj v GitHub secrets. Bez neho /api/cron/* odmieta všetko.
CRON_SECRET=""
