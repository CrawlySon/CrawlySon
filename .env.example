# ──────────────────────────────────────────────────────────────
#  NutriAI – konfigurácia prostredia
#  Skopíruj tento súbor ako `.env` a doplň hodnoty.
# ──────────────────────────────────────────────────────────────

# Pripojenie na Postgres databázu (Neon / Supabase / Vercel Postgres).
# Príklad (Neon): postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── AI: OpenAI (POVINNÉ pre všetky AI funkcie) ───────────────
# Celá AI logika beží na OpenAI: rozpoznávanie jedla z textu a z fotky,
# čítanie tabuľky z obalu, hodnotenie zdravosti, komentáre a zhrnutia kouča.
# Bez OPENAI_API_KEY AI funkcie nefungujú (kouč použije záložné vety).
# Token NIKDY necommituj – patrí len do env premenných hostingu
# (Vercel → Settings → Environment Variables). Repo je verejné.
OPENAI_API_KEY=""
# Voliteľné (majú rozumné defaulty):
# Hlavný model (predvolene gpt-4.1). Slabšie „mini" modely pri dlhšom zozname
# jedál vynechávajú položky, preto sa neodporúčajú. Modely gpt-5* a o1–o9
# sú podporené (posielajú sa im správne parametre).
# OPENAI_MODEL="gpt-4.1"
# Použije sa, ak hlavný model nie je na účte dostupný.
# OPENAI_FALLBACK_MODEL="gpt-4o-mini"
# OPENAI_TIMEOUT_MS="45000"

# ── Gemini: momentálne NEPOUŽÍVANÉ ───────────────────────────
# Kód Gemini nevolá (balík @google/genai ostal v závislostiach z minulosti).
# Premenné sú tu len pre prípadné budúce napojenie.
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.1-flash-lite"

# POVINNÉ: tajný kľúč na podpis prihlasovacej cookie (min. 16 znakov).
# Bez neho sa NIKTO neprihlási. Vygeneruj napr.: openssl rand -base64 32
SESSION_SECRET="zmen-ma-na-nahodny-dlhy-retazec-min-16"

# Registračný kód pre vytváranie účtov (dáš ho kamarátovi).
# Ak nie je nastavený, použije sa staršia premenná APP_PASSWORD (ak ju máš).
REGISTRATION_CODE="zvol-si-tajny-kod"

# ── PUSH NOTIFIKÁCIE (povinné, ak chceš notifikácie) ──────────
# VAPID kľúče pre Web Push. Bez nich sa notifikácie NEDAJÚ zapnúť.
# Vygeneruj pár príkazom:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
# Kontaktný subjekt (e-mail) – pre VAPID hlavičku.
VAPID_SUBJECT="mailto:tvoj@email.sk"

# ── CRON (automatické pripomienky voda/kouč) ─────────────────
# Tajný kľúč pre cron endpointy. Vo Verceli ho nastav rovnako;
# Vercel ho automaticky posiela v hlavičke Authorization pri cron behu.
CRON_SECRET="nahodny-tajny-retazec"

